# AeroTrust Environment Configuration Template
# Copy this file to .env and populate with local/production values.

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL + PostGIS Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=aerotrust
DB_PASSWORD=aerotrust_secret
DB_NAME=aerotrust

# External Data Services (TODO: OpenSky credentials)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# NOAA SWPC Endpoint
NOAA_SWPC_BASE_URL=https://services.swpc.noaa.gov

# Application Config
CONFIG_PATH=config/thresholds.yaml
DATA_MODE=SYNTHETIC  # Options: REAL, SYNTHETIC
