# AeroTrust Environment Configuration Template
# Copy this file to .env and populate with local/production values.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Modes
DATA_MODE=SYNTHETIC  # Options: REAL, SYNTHETIC
CONFIG_PATH=config/thresholds.yaml
DATASET_TAG=v0.3.2-verified

# PostgreSQL + PostGIS Database (Used for pipeline execution and live backend API)
DB_HOST=localhost
DB_PORT=5432
DB_USER=aerotrust
DB_PASSWORD=aerotrust_secret
DB_NAME=aerotrust

# Optional External Data Ingestion (Inactive in synthetic freeze)
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# NOAA SWPC Endpoint (Public domain space weather ingestion)
NOAA_SWPC_BASE_URL=https://services.swpc.noaa.gov

# Frontend Configuration
# When VITE_STATIC_DEMO=true, frontend runs 100% self-contained from precomputed static snapshots
VITE_STATIC_DEMO=false
VITE_API_BASE_URL=http://localhost:8001/api
